{
  "name": "@pos-buen-gusto/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend mínimo de Fastify para POS Buen Gusto",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
