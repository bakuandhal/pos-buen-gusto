# =============================================================================
# Variables de entorno — POS Buen Gusto
# Copiar este archivo a .env y completar los valores reales.
# Nunca commitear .env con valores reales.
# =============================================================================

# --- Servidor backend (Fastify) ---
# Puerto en el que escucha la API
PORT=3000
# Host en el que escucha la API
HOST=0.0.0.0

# --- Cliente Vue (Vite) ---
# Puerto de desarrollo de Vite (usado por Tauri)
VITE_PORT=1420
# Host de desarrollo de Vite
VITE_HOST=localhost

# --- Tauri ---
# Host para HMR en desarrollo de Tauri
TAURI_DEV_HOST=localhost

# --- Base de datos (reservado para Fase 3) ---
# NO incluir credenciales reales aquí. Ejemplo de formato solamente.
# DATABASE_URL="postgresql://user:password@localhost:5432/pos_buen_gusto"

# --- Impresora (reservado para Fase 6) ---
# Identificador de la impresora DIG-E200I (configurar tras verificar compatibilidad)
# PRINTER_ID=dig-e200i-01
