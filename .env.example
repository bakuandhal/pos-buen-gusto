# =============================================================================
# Variables de entorno — POS Buen Gusto
# Copiar este archivo a .env y completar los valores reales.
# Nunca commitear .env con valores reales.
# =============================================================================

# --- Servidor backend (Fastify) ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Cliente Vue (Vite) ---
VITE_PORT=1420
VITE_HOST=localhost

# --- Tauri ---
TAURI_DEV_HOST=localhost

# --- Base de datos (PostgreSQL + Drizzle ORM) ---
# Ejemplo de formato (NO usar estas credenciales en producción):
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/pos_buen_gusto"
DATABASE_URL="postgresql://postgres:cambiar_esta_contraseña@localhost:5432/pos_buen_gusto"

# URL de base de datos para pruebas (isolada de producción)
TEST_DATABASE_URL="postgresql://postgres:cambiar_esta_contraseña@localhost:5432/pos_buen_gusto_test"

# --- Autenticación (JWT) ---
# Generar con: openssl rand -base64 64
JWT_SECRET="cambiar_este_secreto_por_algo_seguro_y_largo"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY="7d"

# --- CORS ---
# Orígenes permitidos (separados por coma). No usar '*' en producción con autenticación.
CORS_ORIGINS="http://localhost:1420,http://localhost:5173"

# --- Impresora (reservado para Fase 6) ---
# PRINTER_ID=dig-e200i-01
