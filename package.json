{
  "name": "pos-buen-gusto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:server": "cd server && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "lint": "eslint src/**/*.{ts,vue} --ext .ts,.vue",
    "lint:server": "cd server && npm run lint",
    "format": "prettier --check src/**/*.{ts,vue} server/src/**/*.ts",
    "format:write": "prettier --write src/**/*.{ts,vue} server/src/**/*.ts",
    "test": "vitest run",
    "test:server": "cd server && npm run test",
    "test:ui": "vitest --ui",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "check:all": "npm run check && npm run build && cd server && npm run check && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "gsap": "^3.15.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.5"
  }
}
